import random

def GuessGame():
    secret = random.randint(1, 100)
    guess = int((input("Guess the number")))
    tries = 0

                 
    # --- The Logic --- #
    if guess == secret:
       print("You Won!")
    else:
        while guess != secret:
             # Everything indented here keeps repeating
             guess = int(input("Try again: "))
             tries += 1
             if guess < secret:
                print("Too low! ")
             elif guess > secret:
                  print("Too high! ")
             elif guess == secret:
                  print("You Won! ")
                  input("Continue (press space)")
                  print("You took " + str(tries) + " guesses!")
                  print("Quitting")
                  input("Continue (press space)")
                  print("Closing game...")
                  return  # This exits the function immediately!
            


Reverser()


GuessGame()


